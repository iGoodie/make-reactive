{
  "name": "@igoodie/make-reactive",
  "version": "1.0.1",
  "type": "module",
  "description": "",
  "repository": "github:iGoodie/make-reactive",
  "license": "CC BY-SA 4.0",
  "author": {
    "name": "iGoodie",
    "url": "https://github.com/iGoodie",
    "email": "igoodie@programmer.net"
  },
  "keywords": [
    "generate",
    "hook",
    "make",
    "reactive",
    "complex",
    "util",
    "monkey",
    "patch",
    "patcher"
  ],
  "main": "./dist/main.cjs",
  "module": "./dist/main.mjs",
  "types": "./dist/main.d.mts",
  "exports": {
    ".": {
      "types": "./dist/main.d.mts",
      "import": "./dist/main.mjs",
      "require": "./dist/main.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsdown",
    "build:demo": "tsc && vite build -c vite.config.demo.ts",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx",
    "lint:fix": "pnpm run lint --fix",
    "type-check": "tsc --project tsconfig.json --pretty --noEmit",
    "ci": "pnpm run lint && pnpm run type-check",
    "predeploy": "cd demo && pnpm i && pnpm build",
    "deploy": "gh-pages -d demo/dist"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@types/react": "^18.2.19",
    "@types/react-dom": "^18.2.10",
    "@vitejs/plugin-react": "^6.0.0",
    "gh-pages": "^6.3.0",
    "pnpm": "^8.8.0",
    "react-dom": "^18.2.0",
    "sass": "^1.70.0",
    "tsdown": "^0.22.8",
    "typescript": "^5.7.0",
    "unrun": "^0.3.1",
    "vite": "^8.0.0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  }
}
